# Server
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/social_automation
USE_MEMORY_DB=false
SEED_ON_START=false
MEDIA_ROOT=./backend/storage
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=bullmq
QUEUE_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000
API_MIN_INTERVAL_MS=450
API_RATE_LIMIT_BASE_DELAY_MS=1500
LOG_RETENTION_DAYS=14

# Safety switch: true keeps all AI/video/voice/posting integrations mocked.
MOCK_INTEGRATIONS=true
PIPELINE_MAX_RETRIES=3

# Daily automation
ENABLE_CRON=true
CONTENT_CRON=0 10 * * *
ANALYTICS_CRON=0 * * * *

# AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
GPT_MODEL=gpt-4.1
AI_CONTENT_PROVIDER=auto
KIMI_API_KEY=
KIMI_MODEL=kimi-k2-0905-preview
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Video API placeholder: Runway, Pika, or your own adapter endpoint
VIDEO_API_PROVIDER=mock
VIDEO_API_KEY=
VIDEO_API_URL=

# Telegram approval bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Publisher placeholders
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=v24.0
INSTAGRAM_PUBLISH_POLL_ATTEMPTS=12
INSTAGRAM_PUBLISH_POLL_MS=5000
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=private
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# Frontend
VITE_API_URL=/api
